# ROBOT E-commerce Backend Configuration
#
# Скопируйте этот файл в .env и задайте свои значения.
# Файл .env в репозиторий не попадает (он в .gitignore) — пароли храните только в нём.

# Вход в админку. Без этих двух переменных вход закрыт для всех.
# Пароль задайте длинный и случайный, например: openssl rand -base64 24
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Flask Environment
# На боевом сервере обязательно FLASK_DEBUG=0, иначе при ошибке
# наружу отдаётся консоль с выполнением произвольного кода.
FLASK_ENV=production
FLASK_DEBUG=0

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///./data/products.db

# Server
PORT=5000
HOST=0.0.0.0
